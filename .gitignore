# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/worktrees/

# backfill dry-run/run reports (step 2)
backfill-engagements-report*.json
backfill-assessment-appointment-ids.report*.json
backfill-assessment-completion.report*.json
backfill-assessment-duration.report*.json
backfill-archived-quote-close.report*.json
# #125 report carries the pre-redaction names — never commit
redact-sync-log-names.report*.json
# property-drift backfill checkpoint — carries client names and home
# addresses for every would-create, so it is customer data. Never commit.
.property-backfill-progress.json
.property-backfill-progress.json.tmp
property-backfill-progress*.json
# One checkpoint per --location scope (.property-backfill-progress.loc_kc.json
# and friends). Same customer data, same rule.
.property-backfill-progress.*.json
.property-backfill-progress.*.json.tmp

# Google service-account keys — never commit (GOOGLE_SA_KEY env var is the only home)
*service-account*.json
*service_account*.json
*gserviceaccount*.json
*-sa-key*.json
